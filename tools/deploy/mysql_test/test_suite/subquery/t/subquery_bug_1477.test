# owner: open-source
# owner group: sql1
# tags: optimizer
# description: removing a NOT pair must keep the result type the parent deduced against
#

--disable_query_log
set @@session.explicit_defaults_for_timestamp=off;
--enable_query_log

# Simplifying not(not(pred)) into pred used to change the expression's result
# type, because a predicate that needs no bool wrapper of its own reports
# BIGINT where the removed NOT reported INT32. IFNULL had already cast its
# subquery operand against INT32, so deducing the common type again against
# BIGINT asked for a second implicit cast above that one and the query failed
# with -4016 instead of running.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(1 LIKE "1")));

# cases that already worked: a single NOT is not simplified away, and a literal
# first argument is not cast at all
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(NULL, !(!(1 LIKE "x")));

# the simplified predicate keeps its truth value
SELECT IFNULL((SELECT NULL), !(!(1 LIKE "1"))) AS a,
       IFNULL((SELECT NULL), !(!(1 LIKE "x"))) AS b,
       IFNULL((SELECT NULL), !(!(!(1 LIKE "1")))) AS c,
       IFNULL((SELECT NULL), !(!(1 > 2))) AS d,
       IFNULL((SELECT NULL), !(!(1 = 1))) AS e;
